#!/usr/bin/env python3
"""vorticis-shell — inicia a área de trabalho do Vorticis SO no compositor Wayland.

Superfícies (protocolo wlr-layer-shell):
  * papel de parede  — camada BACKGROUND, tela inteira, água interativa;
  * barra de tarefas — camada TOP, ancorada embaixo (ou em cima), reserva espaço;
  * painel           — camada OVERLAY, criada só enquanto o menu, a personalização ou um
                       menu de contexto estão abertos, com o TAMANHO DO PAINEL (não ocupa a
                       tela inteira; não depende de transparência, que falha sem GPU).
Sem aceleração 3D (VMs, GPUs sem driver), o WebKit desenha por software (VORTICIS_SEM_GPU=1).

Dependências (Debian 13): python3-gi gir1.2-gtk-4.0 gir1.2-webkit-6.0 gir1.2-gtk4layershell-1.0
"""
import ctypes.util
import json
import os
import pwd
import shlex
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlencode

# gtk4-layer-shell precisa ser carregada antes da libwayland.
_lib = ctypes.util.find_library("gtk4-layer-shell")
if _lib and "LD_PRELOAD" not in os.environ:
    os.environ["LD_PRELOAD"] = _lib
    os.execvp(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("WebKit", "6.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, WebKit, Gtk4LayerShell as LS  # noqa: E402

RAIZ = Path(os.environ.get("VORTICIS_SHELL_DIR", "/usr/share/vorticis/shell"))
SEM_GPU = os.environ.get("VORTICIS_SEM_GPU") == "1" or not list(Path("/dev/dri").glob("renderD*"))
CSS_TRANSPARENTE = "window.vorticis-transparente, window.vorticis-transparente > * { background: transparent; }"

ESTADO = {"posicao": "inferior", "altura": 56, "alinhamento": "centro"}
CAMADAS = {}
APP = None


def usuario_atual():
    login = pwd.getpwuid(os.getuid()).pw_name
    nome = (pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0] or login).strip()
    nivel, perfil = "padrao", "basico"
    arq = Path("/etc/vorticis/usuarios")
    if arq.exists():
        for linha in arq.read_text().splitlines():
            partes = linha.split(":")
            if len(partes) == 3 and partes[0] == login:
                nivel, perfil = partes[1], partes[2]
    rotulos = {"admin": "Administrador", "padrao": "Padrão", "convidado": "Convidado", "infantil": "Infantil"}
    versao = Path("/etc/vorticis/versao").read_text().strip() if Path("/etc/vorticis/versao").exists() else ""
    return {"nome": nome, "nivel": rotulos.get(nivel, nivel), "perfil": perfil, "versao": versao,
            "live": Path("/run/live/medium").exists()}


class Superficie:
    def __init__(self, modo, consulta=None):
        self.modo = modo
        self.janela = Gtk.ApplicationWindow(application=APP)
        LS.init_for_window(self.janela)
        LS.set_namespace(self.janela, f"vorticis-{modo}")
        if modo == "papel":
            LS.set_layer(self.janela, LS.Layer.BACKGROUND)
            for borda in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
                LS.set_anchor(self.janela, borda, True)
            LS.set_exclusive_zone(self.janela, -1)
        elif modo == "barra":
            LS.set_layer(self.janela, LS.Layer.TOP)
            for borda in (LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
                LS.set_anchor(self.janela, borda, True)
            LS.set_exclusive_zone(self.janela, ESTADO["altura"])
            self.janela.set_default_size(-1, ESTADO["altura"])
            # Foco sob demanda: sem ele o WebKit não recebe os cliques da barra.
            LS.set_keyboard_mode(self.janela, LS.KeyboardMode.ON_DEMAND)
        else:  # painel
            LS.set_layer(self.janela, LS.Layer.OVERLAY)
            LS.set_keyboard_mode(self.janela, LS.KeyboardMode.ON_DEMAND)
            posicionar_painel(self.janela, consulta)

        gerente = WebKit.UserContentManager()
        gerente.register_script_message_handler("vorticis", None)
        gerente.connect("script-message-received::vorticis", self.mensagem)
        usuario = json.dumps(usuario_atual(), ensure_ascii=False)
        gerente.add_script(WebKit.UserScript.new(
            f"window.VORTICIS_USUARIO = {usuario};",
            WebKit.UserContentInjectedFrames.TOP_FRAME, WebKit.UserScriptInjectionTime.START, None, None))

        self.web = WebKit.WebView(user_content_manager=gerente)
        cfg = self.web.get_settings()
        cfg.set_allow_file_access_from_file_urls(True)
        cfg.set_hardware_acceleration_policy(
            WebKit.HardwareAccelerationPolicy.NEVER if SEM_GPU else WebKit.HardwareAccelerationPolicy.ALWAYS)
        if modo == "barra" and not SEM_GPU:
            # Fundo transparente só com GPU: no desenho por software o WebKit apaga as áreas
            # não redesenhadas de páginas transparentes (a barra "sumia" ao passar o mouse).
            self.janela.add_css_class("vorticis-transparente")
            transparente = Gdk.RGBA()
            transparente.parse("rgba(0,0,0,0)")
            self.web.set_background_color(transparente)
        params = {"modo": modo, **(consulta or {})}
        if SEM_GPU:
            params["solido"] = "1"
        self.web.load_uri((RAIZ / "index.html").as_uri() + "?" + urlencode(params))
        self.janela.set_child(self.web)
        self.janela.present()

    def js(self, codigo):
        self.web.evaluate_javascript(codigo, -1, None, None, None, None, None)

    def mensagem(self, _gerente, valor):
        try:
            dados = json.loads(valor.to_string())
        except ValueError:
            return
        acao = dados.get("acao")
        if os.environ.get("VORTICIS_DEPURAR"):
            print(f"vorticis-shell: [{self.modo}] {dados}", file=sys.stderr, flush=True)
        if acao == "abrir":
            GLib.idle_add(lambda: fechar_painel() and False)
            # O comando vem do catálogo local do shell; executa sem shell para evitar injeção.
            try:
                subprocess.Popen(shlex.split(dados.get("cmd", "")), start_new_session=True)
            except (OSError, ValueError) as e:
                print("vorticis-shell: falha ao abrir", dados.get("app"), e, file=sys.stderr)
        elif acao == "abrir-painel":
            # Criar/destruir janelas de dentro do callback do WebKit é reentrante: adia para o laço.
            GLib.idle_add(lambda: abrir_painel(dados) and False)
        elif acao in ("painel", "fechar-painel") and not dados.get("aberto"):
            GLib.idle_add(lambda: fechar_painel() and False)
        elif acao == "barra" and self.modo == "barra":
            ESTADO["posicao"] = "superior" if dados.get("posicao") == "superior" else "inferior"
            ESTADO["alinhamento"] = dados.get("alinhamento", "centro")
            ESTADO["altura"] = {"pequeno": 46, "medio": 56, "grande": 64}.get(dados.get("tamanho"), 56)
            LS.set_anchor(self.janela, LS.Edge.TOP, ESTADO["posicao"] == "superior")
            LS.set_anchor(self.janela, LS.Edge.BOTTOM, ESTADO["posicao"] == "inferior")
            self.janela.set_default_size(-1, ESTADO["altura"])
            # Ocultar automaticamente: a barra não reserva espaço; as janelas usam a tela inteira.
            LS.set_exclusive_zone(self.janela, 0 if dados.get("ocultar") else ESTADO["altura"])
        elif acao == "energia-sessao":
            comandos = {"bloquear": ["swaylock", "-f", "-c", "03214a"], "desligar": ["systemctl", "poweroff"],
                        "reiniciar": ["systemctl", "reboot"], "sair": ["labwc", "--exit"]}
            if dados.get("acao") in comandos:
                subprocess.Popen(comandos[dados["acao"]], start_new_session=True)
        elif acao == "preferencia":
            chamada = f"window.vorticisPreferencia({json.dumps(dados.get('chave'))}, {json.dumps(dados.get('valor'))})"
            for outra in list(CAMADAS.values()):
                if outra is not self:
                    outra.js(chamada)
        elif acao == "energia":
            perfil = "desempenho" if dados.get("perfil") == "desempenho" else "equilibrado"
            subprocess.Popen(["vorticis-recursos", "energia", perfil], stderr=subprocess.DEVNULL)


def posicionar_painel(janela, c):
    """Tamanho e posição do painel, junto da barra (as bordas da barra já são respeitadas
    pelo compositor, porque a barra reserva espaço com exclusive zone)."""
    painel = c.get("painel")
    perto = LS.Edge.TOP if ESTADO["posicao"] == "superior" else LS.Edge.BOTTOM
    if painel == "menu":
        largura, altura = 680, 600
        LS.set_anchor(janela, perto, True)
        if ESTADO["alinhamento"] == "esquerda":
            LS.set_anchor(janela, LS.Edge.LEFT, True)
            LS.set_margin(janela, LS.Edge.LEFT, 8)
    elif painel == "config":
        largura, altura = 440, 660
        LS.set_anchor(janela, perto, True)
        LS.set_anchor(janela, LS.Edge.RIGHT, True)
        LS.set_margin(janela, LS.Edge.RIGHT, 8)
    else:  # menus de contexto
        itens = {"ctx-app": 5, "ctx-barra": 2, "ctx-papel": 4}.get(painel, 4)
        largura, altura = 240, itens * 37 + 14
        LS.set_anchor(janela, LS.Edge.LEFT, True)
        LS.set_margin(janela, LS.Edge.LEFT, max(0, int(float(c.get("x", 0))) - 20))
        if painel == "ctx-papel":
            LS.set_anchor(janela, LS.Edge.TOP, True)
            LS.set_margin(janela, LS.Edge.TOP, max(0, int(float(c.get("y", 0)))))
        else:
            LS.set_anchor(janela, perto, True)
    if painel != "ctx-papel":
        LS.set_margin(janela, perto, 8)
    janela.set_default_size(largura, altura)


def abrir_painel(dados):
    painel = dados.get("painel")
    atual = CAMADAS.get("painel")
    mesmo = atual is not None and atual.painel == painel and painel in ("menu", "config")
    fechar_painel()
    if mesmo:  # clicar de novo no botão do menu fecha o menu
        return
    consulta = {k: str(v) for k, v in dados.items() if k in ("painel", "aba", "app", "x", "y") and v is not None}
    sup = Superficie("painel", consulta)
    sup.painel = painel
    CAMADAS["painel"] = sup


def fechar_painel():
    sup = CAMADAS.pop("painel", None)
    if sup is not None:
        sup.janela.destroy()


def ativar(app):
    global APP
    APP = app
    app.hold()  # o shell continua ativo mesmo sem janelas de painel
    css = Gtk.CssProvider()
    if hasattr(css, "load_from_string"):  # GTK ≥ 4.12
        css.load_from_string(CSS_TRANSPARENTE)
    else:
        css.load_from_data(CSS_TRANSPARENTE, -1)
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    for modo in ("papel", "barra"):
        CAMADAS[modo] = Superficie(modo)
    # Ações para atalhos de teclado do compositor (tecla Super abre o menu):
    #   gapplication action org.vorticis.Shell menu
    for nome, painel in (("menu", "menu"), ("personalizar", "config")):
        acao = Gio.SimpleAction.new(nome, None)
        acao.connect("activate", lambda _a, _p, painel=painel: abrir_painel({"painel": painel}))
        app.add_action(acao)


if __name__ == "__main__":
    aplicacao = Gtk.Application(application_id="org.vorticis.Shell")
    aplicacao.connect("activate", ativar)
    aplicacao.run(None)
