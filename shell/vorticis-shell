#!/usr/bin/env python3
"""vorticis-shell — inicia a área de trabalho do Vorticis SO no compositor Wayland.

Cria três superfícies (protocolo wlr-layer-shell):
  * papel de parede  — camada BACKGROUND, tela inteira, água interativa;
  * barra de tarefas — camada TOP, ancorada embaixo (ou em cima), reserva espaço;
  * menus            — camada OVERLAY, tela inteira e transparente, só visível enquanto
                       o menu, a personalização ou um menu de contexto estão abertos.
Sem aceleração 3D (VMs, GPUs sem driver), o WebKit desenha por software (VORTICIS_SEM_GPU=1).

Dependências (Debian 13): python3-gi gir1.2-gtk-4.0 gir1.2-webkit-6.0 gir1.2-gtk4layershell-1.0
"""
import ctypes.util
import json
import os
import pwd
import shlex
import subprocess
import sys
from pathlib import Path

# gtk4-layer-shell precisa ser carregada antes da libwayland.
_lib = ctypes.util.find_library("gtk4-layer-shell")
if _lib and "LD_PRELOAD" not in os.environ:
    os.environ["LD_PRELOAD"] = _lib
    os.execvp(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("WebKit", "6.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gtk, WebKit, Gtk4LayerShell as LS  # noqa: E402

RAIZ = Path(os.environ.get("VORTICIS_SHELL_DIR", "/usr/share/vorticis/shell"))
ALTURA_BARRA = 64
SEM_GPU = os.environ.get("VORTICIS_SEM_GPU") == "1" or not list(Path("/dev/dri").glob("renderD*"))

CSS_TRANSPARENTE = "window.vorticis-transparente, window.vorticis-transparente > * { background: transparent; }"


def usuario_atual():
    login = pwd.getpwuid(os.getuid()).pw_name
    nome = (pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0] or login).strip()
    nivel, perfil = "padrao", "basico"
    arq = Path("/etc/vorticis/usuarios")
    if arq.exists():
        for linha in arq.read_text().splitlines():
            partes = linha.split(":")
            if len(partes) == 3 and partes[0] == login:
                nivel, perfil = partes[1], partes[2]
    rotulos = {"admin": "Administrador", "padrao": "Padrão", "convidado": "Convidado", "infantil": "Infantil"}
    return {"nome": nome, "nivel": rotulos.get(nivel, nivel), "perfil": perfil}


class Superficie:
    def __init__(self, app, modo):
        self.modo = modo
        self.posicao = "inferior"
        self.janela = Gtk.ApplicationWindow(application=app)
        LS.init_for_window(self.janela)
        LS.set_namespace(self.janela, f"vorticis-{modo}")
        if modo == "menu":
            LS.set_layer(self.janela, LS.Layer.OVERLAY)
            for borda in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
                LS.set_anchor(self.janela, borda, True)
            LS.set_exclusive_zone(self.janela, -1)
            LS.set_keyboard_mode(self.janela, LS.KeyboardMode.ON_DEMAND)
        elif modo == "papel":
            LS.set_layer(self.janela, LS.Layer.BACKGROUND)
            for borda in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
                LS.set_anchor(self.janela, borda, True)
            LS.set_exclusive_zone(self.janela, -1)
        else:
            LS.set_layer(self.janela, LS.Layer.TOP)
            for borda in (LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
                LS.set_anchor(self.janela, borda, True)
            LS.set_exclusive_zone(self.janela, ALTURA_BARRA)
            self.janela.set_default_size(-1, ALTURA_BARRA)

        gerente = WebKit.UserContentManager()
        gerente.register_script_message_handler("vorticis", None)
        gerente.connect("script-message-received::vorticis", self.mensagem)
        usuario = json.dumps(usuario_atual(), ensure_ascii=False)
        gerente.add_script(WebKit.UserScript.new(
            f"window.VORTICIS_USUARIO = {usuario};",
            WebKit.UserContentInjectedFrames.TOP_FRAME, WebKit.UserScriptInjectionTime.START, None, None))

        self.web = WebKit.WebView(user_content_manager=gerente)
        cfg = self.web.get_settings()
        cfg.set_allow_file_access_from_file_urls(True)
        cfg.set_hardware_acceleration_policy(
            WebKit.HardwareAccelerationPolicy.NEVER if SEM_GPU else WebKit.HardwareAccelerationPolicy.ALWAYS)
        if modo in ("barra", "menu"):
            self.janela.add_css_class("vorticis-transparente")
            transparente = Gdk.RGBA()
            transparente.parse("rgba(0,0,0,0)")
            self.web.set_background_color(transparente)
        self.web.load_uri((RAIZ / "index.html").as_uri() + f"?modo={modo}")
        self.janela.set_child(self.web)
        if modo == "menu":
            self.janela.set_visible(False)
        else:
            self.janela.present()

    def js(self, codigo):
        self.web.evaluate_javascript(codigo, -1, None, None, None, None, None)

    def mensagem(self, _gerente, valor):
        try:
            dados = json.loads(valor.to_string())
        except Exception:
            return
        acao = dados.get("acao")
        if acao == "abrir":
            # Comando vem do catálogo local do shell; executa sem shell para evitar injeção.
            try:
                subprocess.Popen(shlex.split(dados.get("cmd", "")), start_new_session=True)
            except (OSError, ValueError) as e:
                print("vorticis-shell: falha ao abrir", dados.get("app"), e, file=sys.stderr)
        elif acao == "abrir-painel" and "menu" in CAMADAS:
            # A barra ou o papel pedem um painel: mostra a camada de menus e abre o painel nela.
            menu = CAMADAS["menu"]
            menu.janela.present()
            menu.js(f"window.vorticisAbrirPainel({json.dumps(dados.get('painel'))}, {json.dumps(dados)})")
        elif acao == "painel" and self.modo == "menu" and not dados.get("aberto"):
            self.janela.set_visible(False)
        elif acao == "barra" and self.modo == "barra":
            self.posicao = "superior" if dados.get("posicao") == "superior" else "inferior"
            altura = {"pequeno": 46, "medio": 56, "grande": 64}.get(dados.get("tamanho"), 56)
            LS.set_anchor(self.janela, LS.Edge.TOP, self.posicao == "superior")
            LS.set_anchor(self.janela, LS.Edge.BOTTOM, self.posicao == "inferior")
            self.janela.set_default_size(-1, altura)
            # Ocultar automaticamente: a barra não reserva espaço; as janelas usam a tela inteira.
            LS.set_exclusive_zone(self.janela, 0 if dados.get("ocultar") else altura)
        elif acao == "energia-sessao":
            comandos = {"bloquear": ["swaylock", "-f", "-c", "03214a"], "desligar": ["systemctl", "poweroff"],
                        "reiniciar": ["systemctl", "reboot"], "sair": ["labwc", "--exit"]}
            if dados.get("acao") in comandos:
                subprocess.Popen(comandos[dados["acao"]], start_new_session=True)
        elif acao == "preferencia":
            chamada = f"window.vorticisPreferencia({json.dumps(dados.get('chave'))}, {json.dumps(dados.get('valor'))})"
            for outra in CAMADAS.values():
                if outra is not self:
                    outra.js(chamada)
        elif acao == "energia":
            subprocess.Popen(["vorticis-recursos", "energia", "desempenho" if dados.get("perfil") == "desempenho" else "equilibrado"])


CAMADAS = {}


def ativar(app):
    css = Gtk.CssProvider()
    if hasattr(css, "load_from_string"):  # GTK ≥ 4.12
        css.load_from_string(CSS_TRANSPARENTE)
    else:
        css.load_from_data(CSS_TRANSPARENTE, -1)
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    for modo in ("papel", "barra", "menu"):
        CAMADAS[modo] = Superficie(app, modo)


if __name__ == "__main__":
    aplicacao = Gtk.Application(application_id="org.vorticis.Shell")
    aplicacao.connect("activate", ativar)
    aplicacao.run(None)
