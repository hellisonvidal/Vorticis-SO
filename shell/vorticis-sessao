#!/bin/sh
# vorticis-sessao — inicia a sessão gráfica do Vorticis SO (chamado pelo greetd).
# Tenta o compositor com aceleração por GPU; se ele não subir (VM sem 3D, GPU sem driver),
# repete com renderização por software para o usuário nunca ficar com a tela preta.
export XDG_CURRENT_DESKTOP=Vorticis:wlroots
export XDG_SESSION_DESKTOP=vorticis
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"

inicio=$(date +%s)
if ls /dev/dri/renderD* >/dev/null 2>&1; then
    labwc "$@" && exit 0
    # Saiu com erro em menos de 20 s: a aceleração falhou.
    [ $(( $(date +%s) - inicio )) -gt 20 ] && exit 1
    logger -t vorticis-sessao "labwc falhou com GPU; usando renderização por software"
fi
export WLR_RENDERER=pixman
export VORTICIS_SEM_GPU=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1
export LIBGL_ALWAYS_SOFTWARE=1
exec labwc "$@"
