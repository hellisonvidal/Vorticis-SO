<?xml version="1.0"?>
<labwc_config>
  <theme>
    <name>Vorticis</name>
    <cornerRadius>10</cornerRadius>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>Bold</weight></font>
  </theme>
  <keyboard>
    <layout>br</layout>
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="gapplication action org.vorticis.Shell menu"/></keybind>
    <keybind key="W-p"><action name="Execute" command="gapplication action org.vorticis.Shell personalizar"/></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot"/></keybind>
    <keybind key="W-space"><action name="Execute" command="fuzzel"/></keybind>
    <keybind key="W-e"><action name="Execute" command="nautilus"/></keybind>
    <keybind key="W-l"><action name="Execute" command="swaylock -f -c 03214a"/></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize"/></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left"/></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right"/></keybind>
    <keybind key="Print"><action name="Execute" command="sh -c 'grim ~/Imagens/captura-$(date +%s).png'"/></keybind>
  </keyboard>
</labwc_config>
