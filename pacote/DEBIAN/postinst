#!/bin/sh
# Pós-instalação do pacote vorticis-sistema (instalação nova e atualizações)
set -e
if [ "$1" = "configure" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ -z "$2" ]; then
        # Primeira instalação: liga firewall, ajustes de primeiro boot e verificação de atualizações
        systemctl enable vorticis-rede.service vorticis-primeiro-boot.service >/dev/null 2>&1 || true
        systemctl --global enable vorticis-atualizar.timer >/dev/null 2>&1 || true
    fi
    systemctl try-reload-or-restart vorticis-rede.service >/dev/null 2>&1 || true
    gtk-update-icon-cache -q -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
    update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
    sysctl -q --system >/dev/null 2>&1 || true
fi
exit 0
