#!/bin/sh
# live-config: no pen-drive (modo live), entra direto na área de trabalho Vorticis
# com o usuário "vorticis", sem pedir senha. No sistema instalado este script não roda.
# O usuário live é o primeiro usuário comum (UID 1000), criado pelo user-setup;
# como reserva, lê "username=" da linha de comando do kernel.
USUARIO="$(getent passwd 1000 | cut -d: -f1)"
if [ -z "$USUARIO" ]; then
    USUARIO="$(sed -n 's/.*username=\([^ ]*\).*/\1/p' /proc/cmdline)"
fi
USUARIO="${USUARIO:-vorticis}"
grep -q '^\[initial_session\]' /etc/greetd/config.toml && exit 0
cat >> /etc/greetd/config.toml <<CONF

[initial_session]
command = "vorticis-sessao"
user = "$USUARIO"
CONF
# Atalho do instalador na área de trabalho do live, com o ícone do Vorticis
install -d "/home/$USUARIO/Área de Trabalho"
cp /usr/share/applications/vorticis-instalar-sistema.desktop "/home/$USUARIO/Área de Trabalho/" 2>/dev/null || true
# Esconde o atalho genérico "Install Debian" do pacote calamares-settings-debian
if [ -f /usr/share/applications/calamares-install-debian.desktop ]; then
    sed -i 's/^Name=.*/Name=Instalar Vorticis SO/; s/^Icon=.*/Icon=vorticis/; s/^StartupNotify=True/StartupNotify=true/' \
        /usr/share/applications/calamares-install-debian.desktop
    echo "NoDisplay=true" >> /usr/share/applications/calamares-install-debian.desktop
fi
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop
chown -R "$USUARIO:" "/home/$USUARIO" 2>/dev/null || true
