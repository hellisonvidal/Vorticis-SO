#!/bin/sh
# Configura o sistema dentro da imagem (executado pelo live-build no chroot).
set -e

# --- Arquitetura 32 bits: necessária para Wine e Steam ---
dpkg --add-architecture i386
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    wine32:i386 mesa-vulkan-drivers:i386 libgl1-mesa-dri:i386
echo steam steam/question select "I AGREE" | debconf-set-selections
echo steam steam/license note '' | debconf-set-selections
DEBIAN_FRONTEND=noninteractive apt-get install -y steam-installer || echo "aviso: steam-installer indisponível"

# --- Android: Waydroid (repositório oficial do projeto) ---
if apt-get install -y curl ca-certificates gnupg; then
    curl -fsSL https://repo.waydro.id/waydroid.gpg -o /usr/share/keyrings/waydroid.gpg \
      && echo "deb [signed-by=/usr/share/keyrings/waydroid.gpg] https://repo.waydro.id/ trixie main" \
           > /etc/apt/sources.list.d/waydroid.list \
      && apt-get update && apt-get install -y waydroid \
      || echo "aviso: Waydroid não instalado; disponível depois via 'vorticis-compat preparar android'"
fi

# --- Flatpak + Flathub (Chrome, Brave, Edge, Bottles, Heroic, Discord...) ---
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# --- Usuários e níveis de acesso ---
/usr/bin/vorticis-usuarios configurar

# --- Serviços ---
systemctl enable vorticis-rede.service
systemctl enable systemd-resolved.service
systemctl enable NetworkManager.service
systemctl enable greetd.service
systemctl enable fstrim.timer
systemctl enable power-profiles-daemon.service
systemctl enable systemd-oomd.service
systemctl enable apparmor.service
systemctl enable vorticis-primeiro-boot.service
systemctl disable nftables.service 2>/dev/null || true
systemctl set-default graphical.target

# --- Atualizações de segurança automáticas ---
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'CONF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
CONF

# --- Navegador padrão do sistema ---
update-alternatives --set x-www-browser /usr/bin/firefox-esr || true

# --- Idioma ---
sed -i 's/^# *pt_BR.UTF-8/pt_BR.UTF-8/' /etc/locale.gen && locale-gen
echo 'LANG=pt_BR.UTF-8' > /etc/default/locale

# --- Tema Plymouth (provisório até o tema "gota d'água") ---
plymouth-set-default-theme spinner || true
